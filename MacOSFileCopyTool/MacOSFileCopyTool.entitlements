<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  No App Sandbox, on purpose. The sandbox stamps com.apple.quarantine on every
  file the app writes and won't let the app remove it, so copied apps, scripts
  and installers came out flagged as downloaded. Hardened runtime stays on (it is
  the ENABLE_HARDENED_RUNTIME build setting, not an entitlement).
  AppConfigurationTests fails if the sandbox is turned back on.
-->
<dict/>
</plist>
